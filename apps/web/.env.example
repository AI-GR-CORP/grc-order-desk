# Public URL of this dashboard (no trailing slash). Used for the Gmail OAuth redirect.
APP_URL=https://desk.grcorporation.co.in

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=            # service_role / secret key — server only, never NEXT_PUBLIC

# Google Cloud → APIs & Services → Credentials → OAuth client (Web). Same client the worker uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. MUST be identical in the worker. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Optional: suggests this Workspace domain on Google's sign-in screen.
NEXT_PUBLIC_LOGIN_DOMAIN=grcorporation.co.in
