{
  "name": "@grc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import-sheet": "tsx --env-file=.env src/scripts/import-sheet.ts",
    "import-pictures": "tsx --env-file=.env src/scripts/import-pictures.ts",
    "eval": "tsx --env-file=.env src/scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "0.36.0",
    "@anthropic-ai/sdk": "0.137.0",
    "@grc/core": "workspace:*",
    "@supabase/supabase-js": "2.118.0",
    "exceljs": "4.4.0",
    "html-to-text": "9.0.5",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "sharp": "0.34.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
