# Supabase → Connect → "Session pooler" connection string (IPv4-friendly). Include the password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=require

# For picture thumbnails (Supabase Storage).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Same OAuth client and encryption key as the dashboard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# AI: anthropic (default) or bedrock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Bedrock only:
# AWS_REGION=ap-south-1
# BEDROCK_MODEL_MAP={"claude-haiku-5-5":"<bedrock model or inference profile id>","claude-sonnet-5-5":"<…>"}

# Tuning (defaults shown)
# AI_EFFORT_TRIAGE=low
# AI_EFFORT_EXTRACT=medium
# AI_CONCURRENCY=4
# AI_BATCH_MIN=50
# WORKER_CONCURRENCY=2
# SYNC_INTERVAL_MINUTES=5
# LOG_LEVEL=info
